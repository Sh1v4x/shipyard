{
  "name": "shipyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local control panel that drives Claude Code (claude -p) on your git worktrees, Linear tickets and GitHub pull requests.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "mock": "tsx server/mock/generate.ts",
    "dev:mock": "SHIPYARD_MOCK=mock/demo.json pnpm dev",
    "lint": "biome lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@tanstack/react-query": "5.104.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.13",
    "lucide-react": "1.61.0",
    "playwright-core": "1.64.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "lefthook": "2.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
