{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "server/**",
      "shared/**",
      "web/src/**",
      "vite.config.ts",
      "vitest.config.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": [
              "Checkbox",
              "Switch",
              "Input",
              "Textarea"
            ]
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "web/src/pages/**",
        "web/src/components/**",
        "web/src/*.tsx",
        "!web/src/main.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@tanstack/react-query": "Les pages et composants passent par web/src/data/ : queries.ts, mutations.ts ou runs.ts."
                },
                "patterns": [
                  {
                    "group": [
                      "**/data/client*"
                    ],
                    "message": "api() et queryClient ne s'utilisent que dans web/src/data/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
