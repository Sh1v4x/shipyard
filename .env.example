# Copy this file to .env.local and fill in the values.

# Linear personal API key: Linear › Settings › Security & access › Personal API keys
LINEAR_API_KEY=

# GitHub token, only if you don't want to use the `gh` login
# GH_TOKEN=

# API port (the Vite dev server runs on 5173)
PORT=4317

# Where new worktrees are created ({project} is replaced by the project name)
WORKTREE_ROOT=~/shipyard/worktrees/{project}

# Where a project added without a local path is cloned
PROJECTS_ROOT=~/shipyard/projects

# Interface address, opened when you click a notification
PANEL_URL=http://localhost:5173/
